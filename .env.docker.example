# Copy to .env.docker and fill in the paths for THIS machine:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# These are HOST-machine paths, used only so docker-compose.yml can mount
# them into the right containers -- the apps inside each container always
# see fixed internal paths (see docker-compose.yml), so nothing else needs
# to change. Same files as the non-Docker setup (.env.example) needs --
# see that file's comments for what each one is and how to get it if you
# don't have it on this machine yet.

PANOPTIC_REPO_HOST=/path/to/PytrochDeepyeast
PANOPTIC_MODEL_DIR_HOST=/path/to/oneformer_output
SAM_CHECKPOINT_HOST=/path/to/sam_vit_h_4b8939.pth
CELLMATE_HOST=/path/to/CellMate

SAM_MODEL_TYPE=vit_h
