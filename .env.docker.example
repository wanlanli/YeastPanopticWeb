# Copy to .env.docker and fill in the model weight paths for THIS machine:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# The panoptic model repo and CellMate are cloned in automatically at
# image-build time (see panoptic_service/Dockerfile and backend/Dockerfile)
# -- nothing to set up for those. Only the model weights below are
# machine-specific and need to be mounted in from the host.

# The fine-tuned checkpoint (model_final.pth) AND its own matching
# config.yaml, saved together from the same training run. Copy this whole
# directory over (it's a few hundred MB-1GB) -- e.g.:
#   rsync -avP old-machine:/home/wlli/Data/oneformer_output/ /path/to/oneformer_output/
PANOPTIC_MODEL_DIR_HOST=/path/to/oneformer_output

# Either copy an existing checkpoint file here, or -- easier, since it's a
# public download -- run this on the host first:
#   cd sam_service && python3 scripts/download_checkpoint.py vit_h
# (vit_b is much smaller/faster if this server has no GPU; must match
# SAM_MODEL_TYPE below.)
SAM_CHECKPOINT_HOST=/path/to/sam_vit_h_4b8939.pth

SAM_MODEL_TYPE=vit_h
